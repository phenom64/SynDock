[ActionPlugins][1]
RightButton;NoModifier=org.syndromatic.syndock.contextmenu

[Containments][1]
activityId=
byPassWM=false
dockWindowBehavior=true
enableKWinEdges=true
formfactor=2
immutability=1
isPreferredForShortcuts=false
lastScreen=-1
layoutId=
location=4
name=Default Dock
onPrimary=true
plugin=org.syndromatic.syndock.containment
raiseOnActivityChange=false
raiseOnDesktopChange=false
timerHide=800
timerShow=100
viewType=0
visibility=3
wallpaperplugin=org.kde.image

[Containments][1][Applets][2]
immutability=1
plugin=org.syndromatic.syndock.plasmoid

[Containments][1][Applets][2][Configuration]
PreloadWeight=0

[Containments][1][Applets][2][Configuration][General]
infoBadgeProminentColorEnabled=true
isInSynDock=true
launchers59=applications:DocSurf.desktop,file:///latte-separator1.desktop,applications:org.kde.falkon.desktop,applications:org.kde.discover.desktop,applications:org.kde.okular.desktop,applications:org.kde.konsole.desktop,applications:systemsettings.desktop
manualScrollTasksType=Disabled

[Containments][1][Applets][4]
immutability=1
plugin=P-Connor.PlasmaDrawer

[Containments][1][Applets][4][Configuration]
PreloadWeight=20

[Containments][1][Applets][4][Configuration][ConfigDialog]
DialogHeight=480
DialogWidth=640

[Containments][1][Applets][4][Configuration][General]
customButtonImage=/usr/share/synos/icons/launchboard.png
favoriteSystemActions=logout
showSystemActions=false
useCustomButtonImage=true
useDirectoryIcons=true

[Containments][1][Applets][5]
immutability=1
plugin=org.kde.plasma.trash

[Containments][1][Applets][5][Configuration]
PreloadWeight=0

[Containments][1][ConfigDialog]
DialogHeight=600
DialogWidth=586

[Containments][1][Configuration]
PreloadWeight=0

[Containments][1][General]
advanced=false
alignment=2
alignmentUpgraded=true
appletOrder=4;2;5
configurationSticker=true
editBackgroundOpacity=0.1
panelSize=100
panelTransparency=30
proportionIconSize=5.800000000000001
screenEdgeMargin=6
shadowOpacity=75
shadowSize=50
shadows=All
shadowsUpgraded=true
showGlow=false
splitterPosition=1
splitterPosition2=4
tasksUpgraded=true
zoomLevel=9

[Containments][1][Indicator]
customType=
enabled=true
type=org.syndromatic.syndock.default

[Containments][1][Indicator][org.syndromatic.syndock.default][General]
activeStyle=Dot
glowApplyTo=OnActive
glowEnabled=true
glowOpacity=0.3
minimizedTaskColoredDifferently=true
size=0.08
thickMargin=0.08

[LayoutSettings]
